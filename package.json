{
  "name": "casper-studios-take-home",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks",
    "dev": "dotenv -- turbo run dev",
    "dev:no-env": "turbo run dev",
    "build": "dotenv -- turbo run build",
    "start": "dotenv -- turbo run start",
    "test": "dotenv -- turbo run test",
    "test:e2e": "dotenv -- turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "db:up": "dotenv -- docker compose -f docker-compose.db.yml up -d --wait",
    "db:down": "dotenv -- docker compose -f docker-compose.db.yml down",
    "db:generate": "dotenv -- pnpm --filter @repo/db generate",
    "db:migrate": "dotenv -- pnpm --filter @repo/db migrate",
    "db:curriculum": "dotenv -- pnpm --filter @repo/api curriculum:sync",
    "db:push": "dotenv -- pnpm --filter @repo/db push",
    "db:seed": "dotenv -- pnpm --filter @repo/db seed",
    "db:studio": "dotenv -- pnpm --filter @repo/db studio",
    "docker:up": "dotenv -- docker compose up --build -d",
    "docker:down": "dotenv -- docker compose down -v",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec biome check --staged --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "catalog:",
    "dotenv-cli": "11.0.0",
    "simple-git-hooks": "2.14.0",
    "turbo": "2.11.7"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "bufferutil",
      "utf-8-validate"
    ]
  }
}
