{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "typecheck": {},
    "test": {
      "env": ["TEST_DATABASE_URL"],
      "passThroughEnv": ["CI", "PLAYWRIGHT_*"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "clean": {
      "cache": false
    }
  }
}
