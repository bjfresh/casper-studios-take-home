# Copy to .env. Every consumer (apps, db scripts, tests, compose) reads these —
# change the port here and nowhere else.

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Created by docker/postgres/init so tests never touch development data.
POSTGRES_TEST_DB=app_test
# 5433, not 5432, so it can't collide with a Postgres installed on the host.
POSTGRES_PORT=5433

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
TEST_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_TEST_DB}

API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Privy (auth). All optional: leave empty and the app still boots — the web app
# shows "sign-in unavailable", and the API rejects every authenticated route
# (it fails closed). Get the values from the Privy dashboard.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# The same app id for the browser. It isn't secret; it needs the NEXT_PUBLIC_
# name so Next inlines it into the client bundle. Defined by reference so the
# id lives in one place.
NEXT_PUBLIC_PRIVY_APP_ID=${PRIVY_APP_ID}
# Optional: lets the API verify tokens without fetching Privy's JWKS.
PRIVY_VERIFICATION_KEY=
